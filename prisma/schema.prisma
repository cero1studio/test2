datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String         @id @default(cuid())
  email        String?        @unique // opcional: las cuentas de cliente pueden ser anónimas
  passwordHash String
  role         String         @default("CLIENT") // CLIENT | ADVERTISER | ADMIN
  handle       String         @unique // alias anónimo; nunca se muestra el correo
  createdAt    DateTime       @default(now())
  sessions     Session[]
  profile      Profile?
  encounters   Encounter[]
  reviews      Review[]
  ratings      ClientRating[]
  reports      Report[]
  favorites    Favorite[]
  requests     ContactRequest[]
}

model Session {
  id        String   @id // sha256 del token; el token solo vive en la cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

model Profile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug               String         @unique
  displayName        String
  age                Int
  city               String
  zone               String         @default("")
  category           String
  description        String
  priceFrom          Int
  whatsapp           String
  status             String         @default("DRAFT") // DRAFT | ACTIVE | PAUSED | REVIEW | SUSPENDED
  verifyCode         String
  kind               String         @default("INDEPENDENT") // INDEPENDENT | AGENCY
  services           String         @default("") // ",masaje,cena,"
  tags               String         @default("") // apariencia y estilo: ",tatuajes,alta,"
  contactMode        String         @default("DIRECT") // DIRECT | REQUEST (número oculto hasta aceptar)
  extras             String         @default("[]") // JSON: [{ label, price }] adicionales configurables
  incall             Boolean        @default(false) // atiende en lugar propio
  outcall            Boolean        @default(false) // atiende a domicilio u hotel
  // Privacidad
  foreignersOnly     Boolean        @default(false) // solo visible para visitantes extranjeros
  discreet           Boolean        @default(false) // fotos difuminadas y contacto oculto para quien no tiene cuenta
  blockedRegions     String         @default("") // ",ANT,EXT," regiones donde NO se muestra
  // Disponibilidad: "ahora" siempre vence sola; el horario es informativo
  availableUntil     DateTime?
  lastSeenAt         DateTime?
  scheduleDays       String         @default("") // ",1,2,3," (0 = domingo)
  scheduleFrom       Int            @default(0) // hora 0-23, hora de Colombia
  scheduleTo         Int            @default(0)
  identityVerifiedAt DateTime?
  photosVerifiedAt   DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  photos             Photo[]
  verifications      Verification[]
  encounters         Encounter[]
  reviews            Review[]
  clientRatings      ClientRating[]
  reports            Report[]
  favorites          Favorite[]
  requests           ContactRequest[]

  @@index([city, category, status])
}

model Photo {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  file      String // nítida, con marca de agua
  blurFile  String // versión difuminada en el servidor (modo discreto)
  kind      String    @default("GALLERY") // GALLERY | STORY
  expiresAt DateTime? // historias: 24 h desde su aprobación
  hash      String    @default("") // huella perceptual para detectar fotos repetidas
  status    String   @default("PENDING") // PENDING | APPROVED
  createdAt DateTime @default(now())
}

model Verification {
  id         String    @id @default(cuid())
  profileId  String
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  code       String
  docFile    String? // se elimina del disco al resolver la solicitud
  selfieFile String? // se conserva en privado como referencia para aprobar fotos
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  note       String    @default("")
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
}

// Un encuentro existe cuando la anunciante genera un código en persona y el
// cliente lo confirma desde su cuenta. Es la prueba de que el servicio ocurrió.
model Encounter {
  id           String        @id @default(cuid())
  publicId     String        @unique // sello verificable públicamente, sin identidades
  code         String        @unique // ficha larga para el enlace del QR
  pin          String        @default("") // PIN de 4 dígitos, válido solo dentro del perfil que lo generó
  attempts     Int           @default(0) // intentos fallidos; al quinto el PIN se anula
  profileId    String
  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  clientId     String?
  client       User?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  expiresAt    DateTime
  confirmedAt  DateTime?
  review       Review?
  clientRating ClientRating?

  @@index([profileId, confirmedAt])
}

model Review {
  id           String    @id @default(cuid())
  encounterId  String    @unique
  encounter    Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  authorId     String
  author       User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  rating       Int
  photosMatch  Boolean
  askedDeposit Boolean
  body         String
  serviceRatings String  @default("{}") // JSON: { masaje: 5, cena: 4 }
  visibility   String    @default("MEMBERS") // MEMBERS (solo con cuenta) | PUBLIC
  status       String    @default("VISIBLE") // VISIBLE | HIDDEN
  createdAt    DateTime  @default(now())
}

// Calificación de la anunciante al cliente: reputación que protege a las demás.
model ClientRating {
  id           String    @id @default(cuid())
  encounterId  String    @unique
  encounter    Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  clientId     String
  client       User      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  rating       Int
  respectful   Boolean
  paidAsAgreed Boolean
  punctual     Boolean
  createdAt    DateTime  @default(now())
}

model Report {
  id         String   @id @default(cuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reporterId String?
  reporter   User?    @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  reason     String
  details    String
  status     String   @default("OPEN") // OPEN | RESOLVED | DISMISSED
  createdAt  DateTime @default(now())
}

// «Avísame cuando esté disponible»
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, profileId])
}

// Solicitud de contacto: el número de la anunciante se entrega solo si ella acepta.
model ContactRequest {
  id        String    @id @default(cuid())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  clientId  String
  client    User      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  message   String
  status    String    @default("PENDING") // PENDING | ACCEPTED | DECLINED
  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@index([profileId, status])
  @@index([clientId, createdAt])
}
